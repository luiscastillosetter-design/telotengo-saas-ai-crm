# =====================================================================
# PLANTILLA DE CONFIGURACIÓN DEL SISTEMA TELOTENGO SOLUTIONS
# INSTRUCCIONES: Copia este archivo, renómbralo a "seguridad.env" 
# y coloca tus propias credenciales en los espacios vacíos.
# =====================================================================

# Contraseña de seguridad para entrar al CRM visual de Streamlit
CRM_PASSWORD="tu_contraseña_aqui"

# Credenciales de Inteligencia Artificial (Groq Cloud)
GROQ_API_KEY="tu_api_key_de_groq_aqui"
GROQ_MODELO="llama-3.1-8b-instant"

# Credenciales de la API Oficial de WhatsApp (Meta Graph API)
META_VERIFY_TOKEN="tu_token_de_verificacion_aqui"
META_PHONE_ID="tu_id_de_numero_aqui"
META_ACCESS_TOKEN="tu_token_de_acceso_aqui"

# Configuración de tu Negocio y Números de Contacto
NEGOCIO_NOMBRE="Nombre de tu Negocio"
NUMERO_JEFE="tunumerodewhatsapp"
NUMERO_BOT_OFICIAL="numerooficialdelbot"